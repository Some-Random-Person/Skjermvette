<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Skjermvette Agent" Manufacturer="Skjermvette" Version="$(Version)"
           UpgradeCode="ca63454d-430b-4189-a284-6f2f55f7c0c4" Scope="perMachine">
    <!-- Same-version upgrades let a test build be installed over the last one. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of the Skjermvette agent is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="Skjermvette">
        <Directory Id="INSTALLFOLDER" Name="Agent">
          <Directory Id="HELPERFOLDER" Name="Helper" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Agent">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.agent)*">
        <Exclude Files="!(bindpath.agent)Skjermvette.Agent.Service.exe" />
        <Exclude Files="!(bindpath.agent)*.pdb" />
        <!-- Development moves the data folder and leaves it open. -->
        <Exclude Files="!(bindpath.agent)appsettings.Development.json" />
      </Files>
      <Files Directory="HELPERFOLDER" Include="!(bindpath.helper)**">
        <Exclude Files="!(bindpath.helper)**.pdb" />
      </Files>
      <Component Directory="INSTALLFOLDER">
        <File Id="ServiceExe" Source="!(bindpath.agent)Skjermvette.Agent.Service.exe" KeyPath="yes" />
        <ServiceInstall Name="Skjermvette Agent" DisplayName="Skjermvette Agent"
                        Description="Counts screen time against the child's daily budget and enforces it."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
          <!-- Windows restarts it if it stops, as in the README's manual install. -->
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ServiceControl" Name="Skjermvette Agent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </Feature>

    <!-- Filled in on PairDlg, or on the command line: msiexec /i Skjermvette.Agent.msi SERVER=https://… PAIRCODE=123456 -->
    <Property Id="SERVER" Value="https://" Secure="yes" />
    <Property Id="PAIRCODE" Secure="yes" Hidden="yes" />

    <!-- As SYSTEM, after the files are in and before the service starts, so it starts paired. -->
    <CustomAction Id="PairDevice" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[INSTALLFOLDER]Skjermvette.Agent.Service.exe&quot; pair [PAIRCODE] --server &quot;[SERVER]&quot;" />
    <CustomAction Id="ForgetDeviceRollback" Directory="INSTALLFOLDER" Execute="rollback" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]Skjermvette.Agent.Service.exe&quot; forget" />
    <CustomAction Id="ForgetDevice" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]Skjermvette.Agent.Service.exe&quot; forget" />
    <CustomAction Id="RequirePairCode"
                  Error="Give the server's address and a pairing code, e.g. msiexec /i Skjermvette.Agent.msi SERVER=https://skjermvette.example.com PAIRCODE=123456" />

    <InstallExecuteSequence>
      <Custom Action="RequirePairCode" Before="InstallInitialize" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT PAIRCODE" />
      <Custom Action="PairDevice" After="InstallFiles" Condition="PAIRCODE AND NOT Installed" />
      <!-- After PairDevice, so a failed pairing doesn't forget a pairing that was there before. -->
      <Custom Action="ForgetDeviceRollback" After="PairDevice" Condition="PAIRCODE AND NOT Installed" />
      <!-- Not when an upgrade removes the old version: the pairing carries over. -->
      <Custom Action="ForgetDevice" After="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <UIRef Id="SkjermvetteUI" />
  </Package>
</Wix>
