# Store and check out text files with LF on every OS, regardless of core.autocrlf.
# Prettier, the .NET tooling and the Linux server all work with LF.
* text=auto eol=lf

# Windows scripts need CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.db binary
