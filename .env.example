# Copy to .env (gitignored) and fill in. Used in production, e.g. by docker-compose.
# In development, appsettings.Development.json already points at a local SQLite file.

# Sqlite or Postgres
Database__Provider=Postgres
ConnectionStrings__DefaultConnection=Host=db;Database=skjermvette;Username=skjermvette;Password=change-me

# The address parents open the dashboard at. Links in emails start with it.
App__PublicUrl=https://skjermvette.example.com

# Emails (confirmations, password resets) go through your own SMTP server or provider.
# Port 465 uses TLS from the start; any other port (e.g. 587) must support STARTTLS.
Email__From=Skjermvette <skjermvette@example.com>
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__User=skjermvette@example.com
Email__Smtp__Password=change-me
